# AWS Load Balancer Controller: turns an Ingress with className "alb" into a real ALB.
clusterName: {{ .Values.clusterName }}
region: {{ .Values.region }}
vpcId: {{ .Values.vpcId }}
serviceAccount:
  create: true
  name: aws-load-balancer-controller
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::{{ .Values.awsAccountId }}:role/{{ .Values.roles.lbController }}
